[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/([^/]+)$), script-path=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung/refs/heads/main/js/Locket_ManhHung07.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung/refs/heads/main/js/js/deleteHeader.js, timeout=60

locket_rc = type=http-response, pattern=https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung/refs/heads/main/js/Locket_Unlocked.js, requires-body=true, max-size=-1, timeout=60
[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
